# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: only needed if you run `python domain_assistant.py --generator ollama`
# (or set GENERATOR_BACKEND=ollama) to use a local Ollama model instead of OpenAI.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
